# Local development configuration (copy to .env)
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# PostgreSQL connection (provisioned on Elite via liouni-db)
DB_HOST=db-elite.liouni.com
DB_PORT=5432
DB_DATABASE=liouni_master
DB_USER=liouni_master_admin
DB_PASSWORD=CHANGE_ME
DB_SSL=true
DATABASE_URL=postgresql://liouni_master_admin:CHANGE_ME@db-elite.liouni.com:5432/liouni_master?sslmode=require
